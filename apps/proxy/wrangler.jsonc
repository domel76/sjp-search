{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sjp-search-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
